# Composio free Hobby key: https://dashboard.composio.dev
# IMPORTANT: also enable "Instant Toolkits" in project Settings and keep the
# one-time $2 free credit balance, otherwise Composio calls will fail.
COMPOSIO_API_KEY=

# Free LLM tier. Defaults: provider=gemini, model=gemini-3.5-flash-lite
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=

# On a 429, try the next model (each has its own free daily quota).
# Comma-separated Groq models; set to an empty string to disable Groq fallbacks.
LLM_FALLBACK_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b
# Optional: add the Gemini free tier as the last fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional tuning (defaults shown)
COMPOSIO_USER_ID=app-research-agent
LLM_DELAY_SECONDS=2.0
MAX_PAGES_PER_APP=5
